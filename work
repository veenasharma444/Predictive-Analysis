# STEP 30: ANALYZE TOP PREDICTIVE FACTOR - MOVEMENT TYPE
# ==========================================================

movement_analysis = (
    model_base
    .groupby("Movement Type", dropna=False)
    .agg(
        Employees=("Attrition", "count"),
        Attrition_Count=("Attrition", "sum"),
        Attrition_Rate=("Attrition", "mean")
    )
    .reset_index()
)

movement_analysis["Attrition_Rate_%"] = (
    movement_analysis["Attrition_Rate"] * 100
)

movement_analysis = movement_analysis.sort_values(
    "Attrition_Rate_%",
    ascending=False
)

print("=" * 60)
print("STEP 30: MOVEMENT TYPE vs ATTRITION")
print("=" * 60)

print(
    movement_analysis[
        [
            "Movement Type",
            "Employees",
            "Attrition_Count",
            "Attrition_Rate_%"
        ]
    ].to_string(index=False)
)
