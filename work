# STEP 35: FEATURE ENGINEERING + DATE TRANSFORMATION
# ============================================================

print("=" * 60)
print("STEP 35: FEATURE ENGINEERING + DATE TRANSFORMATION")
print("=" * 60)

# Work from the clean dataset created in Step 34
modeling_data = model_data_clean.copy()

# ------------------------------------------------------------
# 1. Separate target
# ------------------------------------------------------------

y = modeling_data["Attrition"].copy()

X = modeling_data.drop(
    columns=["Attrition"],
    errors="ignore"
).copy()

# ------------------------------------------------------------
# 2. Date columns
# ------------------------------------------------------------

date_columns = [
    "Actual Join Date",
    "Group Join Date",
    "Confirmation Date",
    "Effective Start Date",
    "Conf. Date (Period Master)",
    "Birth Date",
    "Date Of Joined",
    "Created Date"
]

date_columns = [
    col for col in date_columns
    if col in X.columns
]

print("\nDate columns:")
for col in date_columns:
    print("-", col)

# ------------------------------------------------------------
# 3. Convert date columns safely
# ------------------------------------------------------------

for col in date_columns:
    X[col] = pd.to_datetime(
        X[col],
        errors="coerce"
    )

# ------------------------------------------------------------
# 4. Create a fixed reference date
# ------------------------------------------------------------
# Use the latest available date in the dataset.
# This avoids using the current system date and keeps
# the transformation reproducible.

all_dates = []

for col in date_columns:
    valid_dates = X[col].dropna()

    if len(valid_dates) > 0:
        all_dates.append(valid_dates.max())

if all_dates:
    reference_date = max(all_dates)
else:
    reference_date = pd.Timestamp("2026-01-01")

print("\nReference date:", reference_date)

# ------------------------------------------------------------
# 5. Age
# ------------------------------------------------------------

if "Birth Date" in X.columns:

    X["Age_Years"] = (
        (reference_date - X["Birth Date"])
        .dt.days / 365.25
    )

    # Invalid ages become missing
    X.loc[
        (X["Age_Years"] < 15) |
        (X["Age_Years"] > 100),
        "Age_Years"
    ] = np.nan

# ------------------------------------------------------------
# 6. Calculated tenure
# ------------------------------------------------------------

if "Actual Join Date" in X.columns:

    X["Calculated_Tenure_Years"] = (
        (reference_date - X["Actual Join Date"])
        .dt.days / 365.25
    )

    X.loc[
        X["Calculated_Tenure_Years"] < 0,
        "Calculated_Tenure_Years"
    ] = np.nan

# ------------------------------------------------------------
# 7. Confirmation flag
# ------------------------------------------------------------

if "Confirmation Date" in X.columns:

    X["Is_Confirmed"] = (
        X["Confirmation Date"].notna()
        .astype(int)
    )

# ------------------------------------------------------------
# 8. Data availability indicators
# ------------------------------------------------------------

ot_columns = {
    "OT1": "OT1_Total_OT",
    "OT2": "OT2_Total_OT",
    "OT3": "OT3_Total_OT",
    "OT4": "OT4_Total_OT"
}

for prefix, col in ot_columns.items():

    if col in X.columns:
        X[f"{prefix}_Data_Available"] = (
            X[col].notna()
            .astype(int)
        )

# Salary availability
if "Monthly Gross Salary" in X.columns:

    X["Salary_Data_Available"] = (
        X["Monthly Gross Salary"]
        .notna()
        .astype(int)
    )

# Leave availability
if "Leave_Balance" in X.columns:

    X["Leave_Data_Available"] = (
        X["Leave_Balance"]
        .notna()
        .astype(int)
    )

# ------------------------------------------------------------
# 9. Convert dates into numeric day values
# ------------------------------------------------------------

for col in date_columns:

    X[f"{col}_Days"] = (
        X[col] - pd.Timestamp("1970-01-01")
    ).dt.days

    X[f"{col}_Missing"] = (
        X[col].isna()
        .astype(int)
    )

    # Remove original datetime column
    X.drop(
        columns=[col],
        inplace=True
    )

