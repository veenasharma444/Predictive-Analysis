
# ==========================================================
# STEP 14: MERGE ALL OT FEATURES INTO MODEL BASE
# ==========================================================

# Make sure all employee codes have the same format
for df in [ot1_features, ot2_features, ot3_features, ot4_features]:
    df["_emp_code"] = normalize_emp_code(df["_emp_code"])


# Merge OT1
model_base = model_base.merge(
    ot1_features,
    on="_emp_code",
    how="left",
    validate="one_to_one"
)

# Merge OT2
model_base = model_base.merge(
    ot2_features,
    on="_emp_code",
    how="left",
    validate="one_to_one"
)

# Merge OT3
model_base = model_base.merge(
    ot3_features,
    on="_emp_code",
    how="left",
    validate="one_to_one"
)

# Merge OT4
model_base = model_base.merge(
    ot4_features,
    on="_emp_code",
    how="left",
    validate="one_to_one"
)


print("Model base shape after OT merge:", model_base.shape)

print("\nEmployees with OT1 data:",
      model_base["OT1_Total_OT"].notna().sum())

print("Employees with OT2 data:",
      model_base["OT2_Total_OT"].notna().sum())

print("Employees with OT3 data:",
      model_base["OT3_Total_OT"].notna().sum())

print("Employees with OT4 data:",
      model_base["OT4_Total_OT"].notna().sum())

print("\nEmployees without OT1 data:",
      model_base["OT1_Total_OT"].isna().sum())

print("Employees without OT3 data:",
      model_base["OT3_Total_OT"].isna().sum())
