# STEP 9A: CHECK FORM EMPLOYEE CODE QUALITY
# ==========================================================

print("Total form rows:", len(form_features))

print(
    "Missing employee codes:",
    form_features["_emp_code"].isna().sum()
)

print(
    "Non-missing employee codes:",
    form_features["_emp_code"].notna().sum()
)

print(
    "Unique non-missing employee codes:",
    form_features["_emp_code"].dropna().nunique()
)

print("\nDuplicate non-missing employee codes:")

form_duplicates = (
    form_features["_emp_code"]
    .dropna()
    .value_counts()
)

print(
    form_duplicates[
        form_duplicates > 1
    ].head(20)
)

print(
    "\nNumber of duplicated employee codes:",
    (form_duplicates > 1).sum()
)
