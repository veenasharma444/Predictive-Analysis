
# Normalize resignation employee codes
resignation_codes_clean = normalize_emp_code(
    resignation_data["Employee Code"]
)

# Unique resignation employee codes
resignation_set = set(resignation_codes_clean.dropna())

print("Unique resignation employees:", len(resignation_set))

print("\n--- Resignation employee overlap with feature datasets ---")

for name, codes in [
    ("Employee Master", employee_codes),
    ("OT1", ot1_codes),
    ("OT2", ot2_codes),
    ("OT3", ot3_codes),
    ("OT4", ot4_codes),
    ("Leave", leave_codes),
    ("FORM ONE F", form_codes),
]:
    dataset_set = set(codes.dropna())
    overlap = resignation_set.intersection(dataset_set)

    print(f"{name}: {len(overlap)} matching resigned employees")
