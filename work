# ============================================================
# STEP 48: TOP FEATURE ATTRITION-WISE VALIDATION
# ============================================================

print("=" * 60)
print("STEP 48: TOP FEATURE ATTRITION-WISE VALIDATION")
print("=" * 60)


# ------------------------------------------------------------
# 1. Select top original features
# ------------------------------------------------------------

top_features = (
    original_importance
    .head(20)["Original_Feature"]
    .tolist()
)

print("\nTop 20 features selected for validation:")
for i, feature in enumerate(top_features, 1):
    print(f"{i:02d}. {feature}")


# ------------------------------------------------------------
# 2. Identify which features exist in model_data
# ------------------------------------------------------------

available_features = [
    feature
    for feature in top_features
    if feature in model_data.columns
]

print(
    f"\nAvailable in model_data: "
    f"{len(available_features)}"
)


# ------------------------------------------------------------
# 3. Numerical feature comparison
# ------------------------------------------------------------

numeric_top_features = [
    feature
    for feature in available_features
    if pd.api.types.is_numeric_dtype(
        model_data[feature]
    )
]


print("\n" + "=" * 60)
print("NUMERICAL FEATURES: ATTRITION-WISE COMPARISON")
print("=" * 60)


numeric_comparison = []

for feature in numeric_top_features:

    attrition_0 = model_data.loc[
        model_data["Attrition"] == 0,
        feature
    ].dropna()

    attrition_1 = model_data.loc[
        model_data["Attrition"] == 1,
        feature
    ].dropna()

    if len(attrition_0) == 0 or len(attrition_1) == 0:
        continue

    numeric_comparison.append({
        "Feature": feature,
        "Non_Attrition_Mean": attrition_0.mean(),
        "Attrition_Mean": attrition_1.mean(),
        "Non_Attrition_Median": attrition_0.median(),
        "Attrition_Median": attrition_1.median(),
        "Non_Attrition_Count": len(attrition_0),
        "Attrition_Count": len(attrition_1)
    })


numeric_comparison_df = pd.DataFrame(
    numeric_comparison
)


if len(numeric_comparison_df) > 0:

    print(
        numeric_comparison_df.to_string(
            index=False
        )
    )

else:

    print(
        "No numerical top features available "
        "for comparison."
    )


# ------------------------------------------------------------
# 4. Save numerical comparison
# ------------------------------------------------------------

numeric_comparison_df.to_csv(
    "top_features_attrition_numeric_comparison.csv",
    index=False
)


print("\n" + "=" * 60)
print("STEP 48 SUCCESS")
print("=" * 60)
