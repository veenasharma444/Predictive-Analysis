# Check whether Created Date is available
print("Created Date exists:",
      "Created Date" in model_base.columns)

# Check duplicate employee codes
print(
    "Rows before deduplication:",
    len(model_base)
)

print(
    "Unique employee codes before deduplication:",
    model_base["_emp_code"].nunique()
)


# ----------------------------------------------------------
# Keep the latest record for each employee
# ----------------------------------------------------------

if "Created Date" in model_base.columns:

    model_base["Created Date"] = pd.to_datetime(
        model_base["Created Date"],
        errors="coerce"
    )

    model_base = (
        model_base
        .sort_values("Created Date")
        .drop_duplicates(
            subset="_emp_code",
            keep="last"
        )
        .copy()
    )

else:

    # If Created Date is not available,
    # keep the last occurrence in Employee Master
    model_base = (
        model_base
        .drop_duplicates(
            subset="_emp_code",
            keep="last"
        )
        .copy()
    )


print("\nRows after deduplication:", len(model_base))

print(
    "Unique employee codes after deduplication:",
    model_base["_emp_code"].nunique()
)

print("\nAttrition distribution after deduplication:")
print(model_base["Attrition"].value_counts())

print("\nAttrition percentage after deduplication:")
print(
    round(model_base["Attrition"].mean() * 100, 2),
    "%"
)
