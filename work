# ============================================================

# Use only actual employee/history dates.
# Do NOT use Confirmation Date or Conf. Date (Period Master)
# because they contain future dates up to 2027-01-23.

reference_date_columns = [
    "Actual Join Date",
    "Group Join Date",
    "Effective Start Date",
    "Date Of Joined"
]

reference_dates = []

for col in reference_date_columns:
    if col in X.columns:
        valid_dates = X[col].dropna()

        if len(valid_dates) > 0:
            reference_dates.append(valid_dates.max())

if reference_dates:
    reference_date = max(reference_dates)
else:
    reference_date = pd.Timestamp("2026-01-01")

print("\nReference date:", reference_date)
