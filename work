
# ==========================================================
# STEP 1: CREATE ATTRITION TARGET
# ==========================================================

# Normalize employee codes
employee_master["_emp_code"] = normalize_emp_code(
    employee_master["Employee Code"]
)

resignation_data["_emp_code"] = normalize_emp_code(
    resignation_data["Employee Code"]
)

# Employee codes who have a resignation record
resigned_employee_codes = set(
    resignation_data["_emp_code"].dropna()
)

# Start with current Employee Master
model_base = employee_master.copy()

# Create target
model_base["Attrition"] = model_base["_emp_code"].isin(
    resigned_employee_codes
).astype(int)

print("Total employees in model base:", len(model_base))
print("\nAttrition distribution:")
print(model_base["Attrition"].value_counts())

print("\nAttrition percentage:")
print(model_base["Attrition"].mean() * 100)

print("\nUnique employee codes:")
print(model_base["_emp_code"].nunique())
