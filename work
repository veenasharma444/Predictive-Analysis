def normalize_emp_code(series):
    return (
        series.astype("string")
        .str.strip()
        .str.replace("'", "", regex=False)
        .str.replace(r"\.0$", "", regex=True)
        .replace({"": pd.NA, "nan": pd.NA, "None": pd.NA})
    )


employee_codes = normalize_emp_code(employee_master["Employee Code"])
resignation_codes = normalize_emp_code(resignation["Employee Code"])
ot1_codes = normalize_emp_code(ot1["EMP CODE"])
ot2_codes = normalize_emp_code(ot2["EMP CODE"])
ot3_codes = normalize_emp_code(ot3["EMP CODE"])
ot4_codes = normalize_emp_code(ot4["EMP CODE"])
leave_codes = normalize_emp_code(leave["Employee Code"])
form_codes = normalize_emp_code(form_one_f["Employee Code"])


print("Employee Master codes:", employee_codes.nunique())
print("Resignation codes:", resignation_codes.nunique())
print("OT1 codes:", ot1_codes.nunique())
print("OT2 codes:", ot2_codes.nunique())
print("OT3 codes:", ot3_codes.nunique())
print("OT4 codes:", ot4_codes.nunique())
print("Leave codes:", leave_codes.nunique())
print("FORM ONE F codes:", form_codes.nunique())


print("\n--- Overlap with Employee Master ---")

employee_set = set(employee_codes.dropna())

for name, codes in [
    ("Resignation", resignation_codes),
    ("OT1", ot1_codes),
    ("OT2", ot2_codes),
    ("OT3", ot3_codes),
    ("OT4", ot4_codes),
    ("Leave", leave_codes),
    ("FORM ONE F", form_codes),
]:
    code_set = set(codes.dropna())
    overlap = employee_set.intersection(code_set)

    print(f"{name}: {len(overlap)} matching employees")
