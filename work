# ==========================================================
# 1. IDENTIFY DATE COLUMNS
# ==========================================================

date_cols = [
    c for c in model_features
    if (
        "date" in c.lower()
        or "doj" in c.lower()
        or "birth" in c.lower()
    )
]

print("\nDATE COLUMNS:")
for c in date_cols:
    print(" -", c)


# ==========================================================
# 2. IDENTIFY CATEGORICAL COLUMNS CORRECTLY
# ==========================================================

categorical_cols = []

for c in model_features:

    dtype = model_base[c].dtype

    if (
        pd.api.types.is_object_dtype(dtype)
        or pd.api.types.is_string_dtype(dtype)
        or pd.api.types.is_categorical_dtype(dtype)
    ):
        categorical_cols.append(c)


# Remove date columns from categorical list
categorical_cols = [
    c for c in categorical_cols
    if c not in date_cols
]


# ==========================================================
# 3. IDENTIFY NUMERIC COLUMNS
# ==========================================================

numeric_cols = [
    c for c in model_features
    if c not in categorical_cols
    and c not in date_cols
]


