# Create Age Groups

bins = [18, 25, 35, 45, 55, 70]
labels = ["18-25", "26-35", "36-45", "46-55", "56-70"]

df["AGE_GROUP"] = pd.cut(
    df["AGE"],
    bins=bins,
    labels=labels,
    include_lowest=True
)

df[["AGE", "AGE_GROUP"]].head()





age_dist = (
    df["AGE_GROUP"]
    .value_counts()
    .sort_index()
    .reset_index()
)

age_dist.columns = ["Age Group", "Employees"]

age_dist



plt.figure(figsize=(8,5))

sns.countplot(
    data=df,
    x="AGE_GROUP",
    order=labels
)

plt.title("Employee Distribution by Age Group")
plt.xlabel("Age Group")
plt.ylabel("Employees")

plt.show()



age_attrition = pd.crosstab(
    df["AGE_GROUP"],
    df["ATTRITION"],
    normalize="index"
) * 100

age_attrition.round(2)




age_attrition[1].plot(
    kind="bar",
    figsize=(8,5)
)

plt.title("Attrition % by Age Group")
plt.xlabel("Age Group")
plt.ylabel("Attrition %")

plt.show()


