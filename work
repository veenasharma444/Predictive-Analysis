# ==========================================================
# STEP 26.1: FIX MIXED DATA TYPES IN CATEGORICAL FEATURES
# ==========================================================

print("=" * 70)
print("STEP 26.1: FIXING MIXED CATEGORICAL DATA TYPES")
print("=" * 70)


# ==========================================================
# 1. CHECK WHICH COLUMNS HAVE MIXED TYPES
# ==========================================================

print("\nChecking categorical columns...")

for c in categorical_features:

    types_found = (
        X_train[c]
        .dropna()
        .map(type)
        .value_counts()
    )

    if len(types_found) > 1:

        print(f"\nMixed types found in: {c}")
        print(types_found)


# ==========================================================
# 2. CONVERT ALL CATEGORICAL VALUES TO STRING
# ==========================================================

X_train_fixed = X_train.copy()
X_test_fixed = X_test.copy()

for c in categorical_features:

    X_train_fixed[c] = (
        X_train_fixed[c]
        .astype("string")
    )

    X_test_fixed[c] = (
        X_test_fixed[c]
        .astype("string")
    )


# ==========================================================
# 3. REBUILD CATEGORICAL PIPELINE
# ==========================================================

categorical_pipeline = Pipeline(
    steps=[
        (
            "imputer",
            SimpleImputer(
                strategy="constant",
                fill_value="Missing"
            )
        ),
        (
            "encoder",
            OneHotEncoder(
                handle_unknown="ignore",
                min_frequency=2
            )
        )
    ]
)


# ==========================================================
# 4. REBUILD PREPROCESSOR
# ==========================================================

preprocessor = ColumnTransformer(
    transformers=[
        (
            "numeric",
            numeric_pipeline,
            numeric_features
        ),
        (
            "categorical",
            categorical_pipeline,
            categorical_features
        )
    ],
    remainder="drop"
)


# ==========================================================
# 5. FIT ON TRAINING DATA ONLY
# ==========================================================

X_train_processed = preprocessor.fit_transform(
    X_train_fixed
)

X_test_processed = preprocessor.transform(
    X_test_fixed
)


# ==========================================================
# 6. RESULTS
# ==========================================================

print("\n" + "=" * 70)
print("PREPROCESSING SUCCESSFUL")
print("=" * 70)

print(
    "Original training shape:",
    X_train.shape
)

print(
    "Processed training shape:",
    X_train_processed.shape
)

print(
    "Original test shape:",
    X_test.shape
)

print(
    "Processed test shape:",
    X_test_processed.shape
)


# ==========================================================
# 7. SPARSITY
# ==========================================================

if hasattr(X_train_processed, "nnz"):

    print(
        "\nTraining matrix density:",
        round(
            X_train_processed.nnz /
            (
                X_train_processed.shape[0]
                * X_train_processed.shape[1]
            ) * 100,
            4
        ),
        "%"
    )


# ==========================================================
# 8. FINAL CHECK
# ==========================================================

print("\nTrain attrition cases:", int(y_train.sum()))
print("Test attrition cases:", int(y_test.sum()))

print("\nPreprocessor fitted successfully: YES")
