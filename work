
# ==========================================================
# STEP 12: MERGE FORM FEATURES INTO MODEL BASE
# ==========================================================

# Keep only the useful Form feature columns
form_merge = form_features_clean.copy()

# Make sure employee code is the same type
form_merge["_emp_code"] = form_merge["_emp_code"].astype("string")

# Avoid duplicate employee-code columns from previous merges
form_merge = form_merge.drop_duplicates(
    subset="_emp_code",
    keep="first"
)

# Merge Form features
model_base = model_base.merge(
    form_merge,
    on="_emp_code",
    how="left",
    suffixes=("", "_form")
)

print("Model base shape after Form merge:", model_base.shape)

print("\nForm feature coverage:")
print(
    model_base[
        "Monthly Gross Salary"
    ].notna().sum()
)

print(
    "Employees with Form data:",
    model_base["Monthly Gross Salary"].notna().sum()
)

print(
    "Employees without Form data:",
    model_base["Monthly Gross Salary"].isna().sum()
)
